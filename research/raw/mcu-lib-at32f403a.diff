+/**
+  * @brief  reset the gpio register
+  * @param  gpio_x: to select the gpio peripheral.
+  *         this parameter can be one of the following values:
+  *         GPIOA, GPIOB, GPIOC, GPIOD, GPIOE.
+  * @retval none
+  */
+void gpio_reset(gpio_type *gpio_x)
+{
