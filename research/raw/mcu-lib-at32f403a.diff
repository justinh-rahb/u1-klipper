+  uint8_t g_cmd[USBD_CDC_CMD_MAXPACKET_SIZE];
+  uint8_t g_req;
+  uint16_t g_len, g_rxlen;
+  __IO uint8_t g_tx_completed, g_rx_completed;
+  linecoding_type linecoding;
+}cdc_struct_type;
+
+
+/**
+  * @}
+  */
