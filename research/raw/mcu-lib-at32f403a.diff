+    usbd_ctrl_send(pudev, paudio->g_audio_cur, setup->wLength);
+  }
+  else
+  {
+    *((uint16_t *)paudio->g_audio_cur) = paudio->mic_volume_limits[1];
+    usbd_ctrl_send(pudev, paudio->g_audio_cur, setup->wLength);
