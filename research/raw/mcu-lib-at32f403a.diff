+  LBYTE(USBD_MOUSE_IN_MAXPACKET_SIZE),
+  HBYTE(USBD_MOUSE_IN_MAXPACKET_SIZE),   /* wMaxPacketSize: maximum packe size this endpoint */
+  MOUSE_BINTERVAL_TIME,                  /* bInterval: interval for polling endpoint for data transfers */
