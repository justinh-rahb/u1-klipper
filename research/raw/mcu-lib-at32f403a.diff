+  usbd_core_type *pudev = (usbd_core_type *)udev;
+  msc_type *pmsc = (msc_type *)pudev->class_handler->pdata;
+
+  if(pmsc->cbw_struct.dCBWDataTransferLength != 0)
+  {
+    bot_scsi_sense_code(udev, SENSE_KEY_ILLEGAL_REQUEST, INVALID_COMMAND);
+    return USB_FAIL;
+  }
+
+  pmsc->data_len = 0;
