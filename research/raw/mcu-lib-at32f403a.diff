+typedef enum
+{
+  SDIO_READ_WAIT_CONTROLLED_BY_D2        = 0x00, /*!< the sdio read wait on data2 line */
+  SDIO_READ_WAIT_CONTROLLED_BY_CK        = 0x01  /*!< the sdio read wait on clock line */
+} sdio_read_wait_mode_type;
+
+/**
+  * @brief sdio command structure
