+  0x81, 0x82,                            /*     INPUT (Data,Var,Abs,Vol)   */
+
+  0x09, 0x05,                            /*     USAGE (Push Button)        */
+  0x75, 0x01,                            /*     REPORT_SIZE (1)            */
