+    struct
+    {
+      __IO uint32_t fpx                  : 20;/* [19:0] */
+      __IO uint32_t reserved1            : 12;/* [31:20] */
+    } polcfg2_bit;
+  };
+
+  /**
+    * @brief exint swtrg register, offset:0x10
