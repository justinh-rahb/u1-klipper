+error_status usb_vcp_send_data(void *udev, uint8_t *send_data, uint16_t len);
+
+void usb_vcp_ept0_tx_complete_cb(void *udev);
+void usb_vcp_ept0_rx_complete_cb(void *udev);
+void usb_vcp_in_complete_cb(void *udev, uint8_t ept_num);
+void usb_vcp_out_complete_cb(void *udev, uint8_t ept_num);
+void usb_vcp_sof_cb(void *udev);
+void usb_vcp_device_reset_cb(void *udev);
+void usb_vcp_device_suspend_cb(void *udev);
