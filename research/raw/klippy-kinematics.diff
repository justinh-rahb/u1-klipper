+                'switch_count': 0,
+                'retry_count': 0,
+                'error_count': 0,
+                'last_maintenance_count': 0  # Switch count at last maintenance
+            }
+        else:
+            # If extruder exists, only add missing fields
+            entry = self.data[extruder_name]
+            for key in ['switch_count', 'retry_count', 'error_count', 'last_maintenance_count']:
+                if key not in entry:
