+                        logging.warning(f"Failed to delete {p} or {p}.tmp: {e}")
+                self.pl_env_valid = False
+                logging.info("rm power_loss info success")
+            else:
+                logging.info("klippy is shutdown, power_loss info is not allowed to be removed")
