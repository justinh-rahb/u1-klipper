+  0x01,                                  /* bNumDescriptors: number of HID class descriptor to follow */
+  HID_CLASS_DESC_REPORT,                 /* bDescriptorType: report descriptor type */
+  LBYTE(sizeof(g_usbd_custom_hid_report)),
