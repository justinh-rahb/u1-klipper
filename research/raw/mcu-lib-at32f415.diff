+  * @retval none
+  */
+void usb_global_init(otg_global_type *usbx)
+{
+  /* reset otg moudle */
+  usb_global_reset(usbx);
+
+  /* exit power down mode */
+  usbx->gccfg_bit.pwrdown = TRUE;
+
+  usbx->gccfg_bit.avalidsesen = TRUE;
+  usbx->gccfg_bit.bvalidsesen = TRUE;
