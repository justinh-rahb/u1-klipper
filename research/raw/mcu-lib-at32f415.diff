+typedef enum
+{
+  USBH_MSC_STATE_IDLE,
+  USBH_MSC_STATE_GET_LUN,
+  USBH_MSC_STATE_ERROR,
+  USBH_MSC_STATE_COMPLETE,
+}usbh_msc_ctrl_state_type;
