+  * @retval error status
+  */
+error_status usb_global_reset(otg_global_type *usbx)
+{
+  uint32_t timeout = 0;
+  while(usbx->grstctl_bit.ahbidle == RESET)
+  {
+    if(timeout ++ > 200000)
+    {
+      break;
+    }
+  }
+  timeout = 0;
+  usbx->grstctl_bit.csftrst = TRUE;
+  while(usbx->grstctl_bit.csftrst == SET)
+  {
+    if(timeout ++ > 200000)
+    {
+      break;
+    }
+  }
+  return SUCCESS;
+}
