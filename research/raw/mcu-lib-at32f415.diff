+  CMP_INVERTING_PA0_PA2                  = 0x06, /*!< comparator1/2 inverting connect to pa0/pa2 */
+} cmp_inverting_type;
+
+/**
+  * @brief cmp speed type
+  */
+typedef enum
+{
+  CMP_SPEED_FAST                         = 0x00, /*!< comparator selected fast speed */
+  CMP_SPEED_SLOW                         = 0x01, /*!< comparator selected slow speed */
+} cmp_speed_type;
+
