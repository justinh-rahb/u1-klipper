+  CMP_NON_INVERTING_PA1_PA3              = 0x01, /*!< comparator1/2 non-inverting connect to pa1/pa3 */
+  CMP_NON_INVERTING_PA0_PA2              = 0x02, /*!< comparator1/2 non-inverting connect to pa0/pa2 */
