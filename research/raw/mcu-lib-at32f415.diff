+  msc_bot_trans_type                     bot_trans;
+  usbh_msc_unit_type                     l_unit_n[USBH_SUPPORT_MAX_LUN];
+  uint16_t                               poll_timer;
+  uint8_t buffer[64];
+}usbh_msc_type;
