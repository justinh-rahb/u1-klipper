+  * @}
+  */
+
+/**
+  * @}
+  */
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/lib/at32f415/usbh_class/usbh_hid/usbh_hid_class.c b/lib/at32f415/usbh_class/usbh_hid/usbh_hid_class.c
