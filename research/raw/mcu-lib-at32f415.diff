+      __IO uint32_t cmp2ninvsel          : 2; /* [17:16] */
+      __IO uint32_t reserved2            : 14;/* [31:18] */
+    } ctrlsts2_bit;
+  };
+
+} cmp_type;
+
+/**
+  * @}
+  */
+
+#define CMP                             ((cmp_type *) (CMP_BASE))
