+            toolhead.wait_moves()
+
+            cur_extruder = toolhead.get_extruder()
+            activate_status = cur_extruder.get_extruder_activate_status()
+            if activate_status[0][1] == 0 and cur_extruder.name == activate_status[0][0]:
